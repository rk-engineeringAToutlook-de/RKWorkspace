{
  "$schema": "https://rkworkspace.local/schema/ios-capsule-contract-v0.1.json",
  "contractId": "ios-capsule-contract-v0.1",
  "platforms": ["iOS", "iPadOS"],
  "scope": "FrameCapsule",
  "noFileIngressRequired": true,
  "messages": [
    {
      "type": "CapsuleCreated",
      "requiredPayload": ["capsuleId", "thingId", "displayName", "frameSessionId", "noFileIngress"]
    },
    {
      "type": "CapsuleOpened",
      "requiredPayload": ["capsuleId", "frameSessionId", "leaseId"]
    },
    {
      "type": "CapsuleReturned",
      "requiredPayload": ["capsuleId", "leaseId", "guestKeptOriginalFile"]
    },
    {
      "type": "CapsuleRecovered",
      "requiredPayload": ["capsuleId", "leaseId", "guestFrameInvalidated"]
    }
  ],
  "forbiddenPayloadKeys": ["pdfBytes", "originalBytes", "originalFileBytes", "originalPath", "localPdfPath", "downloadPath", "filePath"],
  "requiredAssertions": {
    "documentsOriginalPdf": false,
    "cachesOriginalPdf": false,
    "tempOriginalPdf": false,
    "filesAppOriginalPdf": false,
    "frameCache": "MemoryOnly"
  }
}
