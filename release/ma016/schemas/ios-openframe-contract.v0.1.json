{
  "$schema": "https://rkworkspace.local/schema/ios-openframe-contract-v0.1.json",
  "contractId": "ios-openframe-contract-v0.1",
  "platforms": ["iOS", "iPadOS"],
  "scope": "OpenFrame",
  "noFileIngressRequired": true,
  "messages": [
    {
      "type": "OpenFrameStarted",
      "requiredPayload": ["frameSessionId", "leaseId", "thingId", "viewerName", "page", "zoom"]
    },
    {
      "type": "OpenFrameReady",
      "requiredPayload": ["frameSessionId", "leaseId", "noFileIngress"]
    },
    {
      "type": "OpenFrameReturned",
      "requiredPayload": ["frameSessionId", "leaseId", "guestKeptOriginalFile"]
    },
    {
      "type": "OpenFrameRecovered",
      "requiredPayload": ["frameSessionId", "leaseId", "guestFrameInvalidated"]
    }
  ],
  "allowedFrameData": ["RenderedPage", "MetadataPreview", "FrameInputAck"],
  "forbiddenPayloadKeys": ["pdfBytes", "originalBytes", "originalFileBytes", "originalPath", "localPdfPath", "downloadPath", "filePath"]
}
