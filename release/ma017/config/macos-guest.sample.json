{
  "profile": "ma017-macos-guest",
  "visibleName": "Ablage macOS",
  "platform": "macOS",
  "role": "FrameGuestSurface",
  "productMode": "PilotLab",
  "ownerDiscovery": {
    "mode": "manual",
    "windowsOwnerHost": "WINDOWS_OWNER_IP",
    "devTransportPort": 57100
