    "noFileIngress": true,
    "memoryOnlyCache": true,
    "allowCapsule": true,
    "allowOpenFrame": true,
    "allowKeepCapsule": false,
    "returnSupported": true,
    "recoverySupported": true
  },
  "ui": {
    "visibleLanguage": "human",
    "showTechnicalDiagnostics": false
  }
}
