{
  "$schema": "https://rkworkspace.local/schema/macos-no-file-ingress-contract-v0.2.json",
  "contractId": "macos-no-file-ingress-contract-v0.2",
  "platform": "macOS",
  "requiredChecks": [
    "sandboxContainsNoPdf",
    "downloadsContainsNoNewPdf",
    "tmpContainsNoNewPdf",
    "frameCacheIsMemoryOnly",
    "payloadContainsNoOriginalPath",
    "payloadContainsNoOriginalBytes",
    "returnClearsFrameCache",
    "revocationClearsFrameCache",
    "recoveryInvalidatesGuestFrame",
    "unauthorizedOpenFrameInputDenied"
  ],
  "expectedOutput": [
    "GuestHasPdfFile: NO",
    "GuestHasOriginalPath: NO",
    "GuestHasCopiedPdfBytes: NO",
    "FrameCache: MemoryOnly",
    "UnauthorizedOpenFrameInput: DENIED",
    "NoFileIngress: SUCCESS"
  ],
  "forbiddenPayloadKeys": ["pdfBytes", "originalBytes", "originalFileBytes", "originalPath", "localPdfPath", "downloadPath", "filePath"],
  "auditEvents": [
    "NoFileIngressChecked",
    "CapsuleOpened",
    "OpenFrameReady",
    "PolicyDenied",
    "CarryLeaseReturned",
    "OwnerRecoveredThing"
  ]
}
