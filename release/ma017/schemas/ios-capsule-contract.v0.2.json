{
  "$schema": "https://rkworkspace.local/schema/ios-capsule-contract-v0.2.json",
  "contractId": "ios-capsule-contract-v0.2",
  "platforms": ["iPadOS", "iOS"],
  "scope": "FrameCapsule",
  "noFileIngressRequired": true,
  "messages": [
    {
      "type": "CapsuleCreated",
      "direction": "owner-to-guest",
      "requiredPayload": ["capsuleId", "thingId", "displayName", "frameSessionId", "leaseId", "noFileIngress"]
    },
    {
      "type": "CapsuleOpened",
      "direction": "guest-to-owner",
      "requiredPayload": ["capsuleId", "frameSessionId", "leaseId"]
    },
    {
      "type": "CapsuleReturned",
      "direction": "guest-to-owner",
      "requiredPayload": ["capsuleId", "leaseId", "guestKeptOriginalFile"]
    }
  ],
  "forbiddenPayloadKeys": ["pdfBytes", "originalBytes", "originalFileBytes", "originalPath", "localPdfPath", "downloadPath", "filePath"],
  "requiredAssertions": {
    "guestHasPdfFile": false,
    "guestHasOriginalPath": false,
    "guestHasCopiedPdfBytes": false,
    "frameCache": "MemoryOnly"
  }
}
